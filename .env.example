# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Viora
APP_VERSION=1.0.0
ENVIRONMENT=development       # development | production | testing
DEBUG=false
LOG_LEVEL=INFO

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Admin Dashboard ──────────────────────────────────────────────────────────
DASHBOARD_ADMIN_KEY=change-me-admin-key

# ─── HMS / EHR ────────────────────────────────────────────────────────────────
# Set to "mock" for development (no credentials needed)
# Set to "eka_care" for production with Eka Care credentials
HMS_PROVIDER=mock

# Eka Care credentials (only needed when HMS_PROVIDER=eka_care)
# Obtain from: hub.eka.care → API Tokens
EKA_CLIENT_ID=
EKA_CLIENT_SECRET=
EKA_BASE_URL=https://api.eka.care

# ─── Sarvam AI ────────────────────────────────────────────────────────────────
# Sign up at: sarvam.ai → Get free ₹1,000 credits
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEED=0.92
SARVAM_DEFAULT_VOICE=vidya

# ─── Gemini (LLM) ─────────────────────────────────────────────────────────────
# Get free API key at: aistudio.google.com
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=512

# ─── LiveKit ──────────────────────────────────────────────────────────────────
# Sign up at: livekit.io → Create project → Copy credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Exotel (India Telephony) ─────────────────────────────────────────────────
# Sign up at: exotel.com → Start free trial
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_VIRTUAL_NUMBER=+91XXXXXXXXXX

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://viora:viora@localhost:5432/viora
DATABASE_POOL_SIZE=10

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379/0
# Upstash free: rediss://...
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ─── DPDP Compliance ──────────────────────────────────────────────────────────
AUDIO_RETENTION_DAYS=7
TRANSCRIPT_RETENTION_DAYS=365

# ─── Voice Agent Tuning ───────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en-IN
VAD_SILENCE_THRESHOLD_MS=800
VAD_ELDERLY_THRESHOLD_MS=1200
MAX_CLARIFICATION_ATTEMPTS=3
